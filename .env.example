# Copy this file to discord_token.env (or .env) and fill in real values.
# NEVER commit the filled-in file -- see .gitignore.
#
# Only variables actually read by pilot_agent's code are listed here.
# (ANTHROPIC_API_KEY is intentionally NOT listed: the project no longer
# calls the Anthropic API directly -- it shells out to the `claude` CLI,
# so that key is unused by current code.)

# Required for the 08:15 Morning Brief / 22:00 Daily Close push
# (pilot_agent/notifications.py). Get this from the Discord Developer
# Portal, "Bot" tab, for the isolated Pilot bot -- not the main dev bot.
DISCORD_BOT_TOKEN=

# Required for the same feature: the Discord channel ID the Pilot bot
# should push into. Right-click the channel in Discord with Developer
# Mode enabled -> "Copy Channel ID".
DISCORD_PILOT_CHANNEL_ID=

# Optional. Overrides where the SQLite database lives
# (pilot_agent/config.py). Default is used when unset -- most setups
# should leave this blank.
PILOT_DB_PATH=
