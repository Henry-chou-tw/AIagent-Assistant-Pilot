# Data is Henry's own -- kept local, not committed by default. Back it
# up/export deliberately (see README.md), don't rely on git history for
# durability of interaction data.
data/pilot.db
data/pilot.db-journal
data/pilot.db-wal
data/pilot.db-shm

# Never commit secrets. If a .env file is ever added for local config,
# it must never be tracked.
.env
*.env
*token*.txt
*secret*

__pycache__/
*.pyc
.venv/
venv/

# --- GitHub migration hardening (2026-09-07) ---
# Broader safety-net patterns on top of the specific rules above.
.env.*
!.env.example
*.db
*.db-journal
*.db-wal
*.db-shm
*.log
logs/
.DS_Store
Thumbs.db

# Stale/scratch artifacts swept up during the GitHub migration -- not
# production data, not meant to ever be tracked. See Migration Report.
_to_delete/
